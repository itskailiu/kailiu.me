
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kai Liu | 刘凯"
  description="刘凯（Kai Liu）的个人主页。"
>
  <main class="home">
    <section class="hero" aria-label="个人介绍">

      <!-- 第一行：姓名 -->
      <h1
        class="title"
        aria-label="你好，我是刘凯。"
      ><span class="greeting" aria-hidden="true">你好，我是</span><span class="name" aria-hidden="true">刘凯。</span></h1>

      <!-- 第二行：问候 -->
      <p class="subtitle">
        很高兴认识你。
      </p>

      <!-- 第三行：关于我 -->
      <a class="about-link" href="/about/">
        <span>关于我</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>

    </section>
  </main>
</BaseLayout>

<style>
  /* 页面整体 */

  .home {
    width: 100%;
    min-height: calc(100svh - 190px);

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 80px 0;
  }

  .hero {
    width: 100%;
    max-width: 760px;
  }

  /* 第一行 */

  .title {
    margin: 0;

    font-size: clamp(38px, 5.5vw, 68px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -1.5px;

    white-space: nowrap;
  }

  .title span {
    display: inline-block;

    opacity: 0;
    transform: translateY(22px);

    animation: titleEnter 2s
      cubic-bezier(.22, 1, .36, 1)
      both;
  }

  .greeting {
    animation-delay: 0s !important;
  }

  .name {
    animation-delay: 0.8s !important;
  }

  /* 第二行 */

  .subtitle {
    margin: 22px 0 0;

    font-size: 22px;
    font-weight: 400;
    line-height: 1.8;
    color: #778294;

    white-space: nowrap;

    opacity: 0;
    transform: translateY(12px);

    animation: subtitleEnter 0.75s
      cubic-bezier(.22, 1, .36, 1)
      2.8s both;
  }

  /* 第三行 */

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    width: fit-content;
    margin-top: 52px;

    font-size: 16px;
    font-weight: 600;
    color: #4268d6;

    transition: color .2s ease;
  }

  .about-link .arrow {
    display: inline-block;
    font-size: 20px;

    transition: transform .25s ease;
  }

  .about-link:hover {
    color: #304fb0;
  }

  .about-link:hover .arrow {
    transform: translateX(5px);
  }

  .about-link:focus-visible {
    outline: 2px solid #4268d6;
    outline-offset: 6px;
    border-radius: 3px;
  }

  /* 动画关键帧 */

  @keyframes titleEnter {
    from {
      opacity: 0;
      transform: translateY(22px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes subtitleEnter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 手机适配 */

  @media (max-width: 760px) {
    .home {
      min-height: calc(100svh - 165px);
      padding: 70px 0;
    }

    .title {
      font-size: clamp(26px, 7.5vw, 44px);
      letter-spacing: -1px;
    }

    .subtitle {
      margin-top: 18px;
      font-size: 19px;
    }

    .about-link {
      margin-top: 42px;
      font-size: 15px;
    }
  }

  /* 减少动态效果 */

  @media (prefers-reduced-motion: reduce) {
    .title span,
    .subtitle {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .about-link .arrow {
      transition: none;
    }
  }
</style>
