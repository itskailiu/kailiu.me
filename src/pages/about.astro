
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="关于我 | Kai Liu"
  description="关于刘凯（Kai Liu）的个人介绍。"
>
  <main class="about">

    <!-- 页面标题 -->
    <header class="intro">
      <p class="eyebrow">ABOUT ME</p>
      <h1>关于我。</h1>
    </header>

    <!-- 个人介绍 -->
    <section class="identity">
      <h2>刘凯 <span>/ Kai Liu</span></h2>

      <p class="description">
        计算机科学与技术方向学生。
      </p>

      <!-- 开发者网站入口 -->
      <a
        class="dev-link"
        href="https://kailiu.dev"
        target="_blank"
        rel="noopener noreferrer"
      >
        前往 kailiu.dev
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    <!-- 返回首页 -->
    <a class="back-link" href="/">
      <span aria-hidden="true">←</span>
      返回首页
    </a>

  </main>
</BaseLayout>

<style>
  /* =========================
     01. 页面整体布局
  ========================= */

  .about {
    width: 100%;
    max-width: 760px;
    min-height: calc(100svh - 190px);
    margin: 0 auto;
    padding: 110px 0 100px;
  }

  /* =========================
     02. 页面标题
  ========================= */

  .eyebrow {
    margin: 0;

    color: #4268d6;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .intro h1 {
    margin: 25px 0 55px;

    font-size: clamp(40px, 5vw, 60px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -1.5px;
  }

  /* =========================
     03. 个人介绍
  ========================= */

  .identity h2 {
    margin: 0 0 20px;

    font-size: 18px;
    font-weight: 500;
    line-height: 1.7;
  }

  .identity h2 span {
    color: #667085;
    font-weight: 400;
  }

  .description {
    margin: 0;

    color: #778294;
    font-size: 16px;
    line-height: 2;
  }

  /* =========================
     04. 开发者网站入口
  ========================= */

  .dev-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-top: 24px;

    color: #4268d6;
    font-size: 15px;
    font-weight: 600;

    transition: color 0.2s ease;
  }

  .dev-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .dev-link:hover {
    color: #304fb0;
  }

  .dev-link:hover span {
    transform: translate(3px, -3px);
  }

  /* =========================
     05. 返回首页
  ========================= */

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-top: 75px;

    color: #667085;
    font-size: 14px;

    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #4268d6;
  }

  /* =========================
     06. 键盘访问
  ========================= */

  .dev-link:focus-visible,
  .back-link:focus-visible {
    outline: 2px solid #4268d6;
    outline-offset: 5px;
    border-radius: 3px;
  }

  /* =========================
     07. 移动端适配
  ========================= */

  @media (max-width: 760px) {
    .about {
      min-height: calc(100svh - 165px);
      padding: 75px 0 90px;
    }

    .intro h1 {
      font-size: 42px;
      margin-bottom: 45px;
    }

    .identity h2 {
      font-size: 17px;
    }

    .description {
      font-size: 15px;
    }

    .dev-link {
      font-size: 14px;
      margin-top: 22px;
    }

    .back-link {
      margin-top: 65px;
    }
  }
</style>
