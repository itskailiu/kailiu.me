
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="关于我 | Kai Liu"
  description="关于刘凯（Kai Liu）。"
>
  <main class="about">

    <section class="intro" aria-labelledby="about-title">
      <p class="eyebrow">ABOUT ME</p>

      <h1 id="about-title">关于我。</h1>

      <div class="identity">
        <h2>
          刘凯 <span>/ Kai Liu</span>
        </h2>

        <p class="quote">
          我，是一路走来的总和。
        </p>
      </div>
    </section>

    <nav class="links" aria-label="了解更多">

      <a
        href="https://kailiu.dev"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>一个学计算机科学的人</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://ours.page"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>一些值得留下的故事</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

    </nav>

    <a class="back-link" href="/">
      <span aria-hidden="true">←</span>
      返回首页
    </a>

  </main>
</BaseLayout>

<style>
  .about {
    width: 100%;
    max-width: 760px;
    min-height: calc(100svh - 190px);
    margin: 0 auto;
    padding: 100px 0 95px;
  }

  .eyebrow {
    margin: 0;
    color: #4268d6;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  h1 {
    margin: 24px 0 65px;
    font-size: clamp(42px, 5vw, 60px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -1.5px;
  }

  .identity h2 {
    margin: 0 0 22px;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.6;
  }

  .identity h2 span {
    color: #98a2b3;
    font-size: 16px;
    font-weight: 400;
  }

  .quote {
    margin: 0;
    color: #778294;
    font-size: 18px;
    line-height: 1.9;
    letter-spacing: 0.2px;
  }

  .links {
    margin-top: 75px;
    border-top: 1px solid #e9e9e5;
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 25px 2px;
    border-bottom: 1px solid #e9e9e5;
    font-size: 16px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .arrow {
    color: #4268d6;
    font-size: 20px;
    transition: transform 0.25s ease;
  }

  .links a:hover {
    color: #4268d6;
  }

  .links a:hover .arrow {
    transform: translate(3px, -3px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 65px;
    color: #667085;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #4268d6;
  }

  .links a:focus-visible,
  .back-link:focus-visible {
    outline: 2px solid #4268d6;
    outline-offset: 5px;
    border-radius: 3px;
  }

  @media (max-width: 760px) {
    .about {
      min-height: calc(100svh - 165px);
      padding: 75px 0 85px;
    }

    h1 {
      margin-bottom: 52px;
      font-size: 42px;
    }

    .identity h2 {
      font-size: 19px;
    }

    .identity h2 span {
      font-size: 15px;
    }

    .quote {
      font-size: 16px;
    }

    .links {
      margin-top: 60px;
    }

    .links a {
      font-size: 15px;
      padding: 23px 2px;
    }

    .back-link {
      margin-top: 55px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links a,
    .arrow,
    .back-link {
      transition: none;
    }
  }
</style>
