---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>© {year} Kai Liu</span>
  <span>Learning · Building · Growing</span>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #e9e9e5;
    padding: 30px 0 45px;
    display: flex;
    justify-content: space-between;
    color: #98a2b3;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .site-footer {
      gap: 16px;
      flex-wrap: wrap;
    }
  }
</style>
