---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>© {year} Kai Liu</span>

  <a href="mailto:hello@kailiu.me" aria-label="发送电子邮件">
    Email ↗
  </a>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #e9e9e5;
    padding: 30px 0 45px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #98a2b3;
    font-size: 12px;
  }

  .site-footer a {
    color: #667085;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: #4268d6;
  }

  @media (max-width: 480px) {
    .site-footer {
      flex-wrap: wrap;
    }
  }
</style>
